{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": "Configure",
      "problemMatcher": ["$gcc", "$msCompile"]
    }
  ]
}
